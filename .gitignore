# ---- Dependencies ----
**/node_modules/

# ---- Next.js ----
**/.next/
**/out/

# ---- Python ----
**/.venv/
**/__pycache__/
*.pyc

# ---- Runtime uploads (jaga foldernya, abaikan isinya) ----
backend_js_app_absensi/uploads/*

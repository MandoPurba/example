# Server
NODE_ENV=development
PORT=8001
URL=http://localhost:8001

# Database (used by docker-compose to provision Postgres)
POSTGRES_USER=absensi
POSTGRES_PASSWORD=absensi
POSTGRES_DB=absensi
POSTGRES_PORT=5432

# Connection string used by the app (Sequelize / pg)
DATABASE_URL=postgres://absensi:absensi@localhost:5432/absensi

# Auth / security
JWT_SECRET=dev_jwt_secret_change_me
SIGNATURE_KEY=dev_signature_key_change_me

# External services
URL_PYTHON_SERVER=http://localhost:8000
